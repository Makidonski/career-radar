# --- Django ---
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# --- Postgres (shared by Django + FastAPI) ---
POSTGRES_DB=career_radar
POSTGRES_USER=career_radar
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Internal service-to-service auth ---
INTERNAL_SHARED_SECRET=change-me-internal-secret

# --- hh.ru API ---
HH_API_BASE_URL=https://api.hh.ru
HH_USER_AGENT=CareerRadar/1.0 (contact: you@example.com)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=change-me-telegram-token
DJANGO_INTERNAL_API_URL=http://django:8000/api
FASTAPI_INTERNAL_URL=http://fastapi:8001

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001